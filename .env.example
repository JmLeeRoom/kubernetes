# ──────────────────────────────────────────────
#  Frontend
# ──────────────────────────────────────────────
VITE_API_BASE_URL=/api/v1
VITE_MSW_ENABLED=false

# ──────────────────────────────────────────────
#  Shared Infrastructure
# ──────────────────────────────────────────────
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops
POSTGRES_DB=mlops

# ──────────────────────────────────────────────
#  Backend — monitoring-svc
# ──────────────────────────────────────────────
MONITORING_PROMETHEUS_URL=http://prometheus:9090
MONITORING_LOKI_URL=http://loki:3100
MONITORING_TEMPO_URL=http://tempo:3200
MONITORING_ALERTMANAGER_URL=http://alertmanager:9093
MONITORING_REDIS_URL=redis://redis:6379/1
MONITORING_LOG_LEVEL=INFO

# ──────────────────────────────────────────────
#  Backend — serving-svc
# ──────────────────────────────────────────────
SERVING_KSERVE_NAMESPACE=model-serving
SERVING_PROMETHEUS_URL=http://prometheus:9090
SERVING_REDIS_URL=redis://redis:6379/3

# ──────────────────────────────────────────────
#  Backend — mlops-svc
# ──────────────────────────────────────────────
MLOPS_MLFLOW_URL=http://mlflow:5000
MLOPS_AIRFLOW_URL=http://airflow-webserver:8080
MLOPS_AIRFLOW_USERNAME=admin
MLOPS_AIRFLOW_PASSWORD=admin

# ──────────────────────────────────────────────
#  Backend — api-gateway
# ──────────────────────────────────────────────
GATEWAY_MONITORING_SVC_URL=http://monitoring-svc:8000
GATEWAY_PIPELINE_SVC_URL=http://pipeline-svc:8000
GATEWAY_SERVING_SVC_URL=http://serving-svc:8000
GATEWAY_MLOPS_SVC_URL=http://mlops-svc:8000
GATEWAY_REDIS_URL=redis://redis:6379/0
GATEWAY_CORS_ORIGINS=["http://localhost:5173"]
GATEWAY_RATE_LIMIT_REQUESTS=100
GATEWAY_RATE_LIMIT_WINDOW=60
GATEWAY_AUTH_KEYCLOAK_URL=https://keycloak.company.com
GATEWAY_AUTH_REALM=mlops-platform
GATEWAY_AUTH_CLIENT_ID=mlops-dashboard
GATEWAY_AUTH_CLIENT_SECRET=
GATEWAY_AUTH_VERIFY_TOKEN=false
GATEWAY_PROXY_TIMEOUT=30

# ──────────────────────────────────────────────
#  Backend — pipeline-svc
# ──────────────────────────────────────────────
PIPELINE_AIRBYTE_URL=http://airbyte-server:8001
PIPELINE_AIRBYTE_USERNAME=airbyte
PIPELINE_AIRBYTE_PASSWORD=
PIPELINE_AIRBYTE_WORKSPACE_ID=default
PIPELINE_PREFECT_URL=http://prefect-server:4200
PIPELINE_SPARK_URL=http://spark-master:8080
PIPELINE_REDIS_URL=redis://redis:6379/2
PIPELINE_CACHE_TTL=30

# ──────────────────────────────────────────────
#  MLflow
# ──────────────────────────────────────────────
MLFLOW_BACKEND_STORE_URI=postgresql://mlops:mlops@postgres:5432/mlflow
MLFLOW_DEFAULT_ARTIFACT_ROOT=/mlflow/artifacts

# ──────────────────────────────────────────────
#  Airflow
# ──────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://mlops:mlops@postgres:5432/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=true
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# ──────────────────────────────────────────────
#  Auth
# ──────────────────────────────────────────────
AUTH_KEYCLOAK_URL=https://keycloak.company.com
AUTH_REALM=mlops-platform
AUTH_CLIENT_ID=mlops-dashboard
AUTH_CLIENT_SECRET=
AUTH_VERIFY_TOKEN=false
