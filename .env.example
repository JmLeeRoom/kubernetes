# Frontend
VITE_API_BASE_URL=/api/v1
VITE_MSW_ENABLED=false

# Backend — monitoring-svc
MONITORING_PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090
MONITORING_LOKI_URL=http://loki.monitoring.svc.cluster.local:3100
MONITORING_TEMPO_URL=http://tempo.monitoring.svc.cluster.local:3200
MONITORING_REDIS_URL=redis://localhost:6379
MONITORING_LOG_LEVEL=INFO

# Backend — serving-svc
SERVING_KSERVE_NAMESPACE=model-serving

# Backend — mlops-svc
MLOPS_MLFLOW_URL=http://mlflow.mlops-tools.svc.cluster.local:5000
MLOPS_AIRFLOW_URL=http://airflow-webserver.mlops-tools.svc.cluster.local:8080
MLOPS_AIRFLOW_USERNAME=admin
MLOPS_AIRFLOW_PASSWORD=

# Backend — api-gateway
GATEWAY_MONITORING_SVC_URL=http://monitoring-svc:8001
GATEWAY_PIPELINE_SVC_URL=http://pipeline-svc:8002
GATEWAY_SERVING_SVC_URL=http://serving-svc:8003
GATEWAY_MLOPS_SVC_URL=http://mlops-svc:8004
GATEWAY_REDIS_URL=redis://localhost:6379/0
GATEWAY_CORS_ORIGINS=["http://localhost:5173"]
GATEWAY_RATE_LIMIT_REQUESTS=100
GATEWAY_RATE_LIMIT_WINDOW=60
GATEWAY_AUTH_KEYCLOAK_URL=https://keycloak.company.com
GATEWAY_AUTH_REALM=mlops-platform
GATEWAY_AUTH_CLIENT_ID=mlops-dashboard
GATEWAY_AUTH_CLIENT_SECRET=
GATEWAY_PROXY_TIMEOUT=30

# Backend — pipeline-svc
PIPELINE_AIRBYTE_URL=http://airbyte-server:8001
PIPELINE_AIRBYTE_USERNAME=airbyte
PIPELINE_AIRBYTE_PASSWORD=
PIPELINE_AIRBYTE_WORKSPACE_ID=default
PIPELINE_PREFECT_URL=http://prefect-server:4200
PIPELINE_SPARK_URL=http://spark-master:8080
PIPELINE_REDIS_URL=redis://localhost:6379/0
PIPELINE_CACHE_TTL=30

# Auth
AUTH_KEYCLOAK_URL=https://keycloak.company.com
AUTH_REALM=mlops-platform
AUTH_CLIENT_ID=mlops-dashboard
AUTH_CLIENT_SECRET=
AUTH_VERIFY_TOKEN=true
